@@ -5720,11 +5730,21 @@
 static void memcomp_select_worker(struct work_struct *work)
 {
 	struct memcomp_compressor_select *select;
-	unsigned long now = jiffies;
+	unsigned long now;
 
 	select = container_of(to_delayed_work(work),
 			      struct memcomp_compressor_select, work);
 	mutex_lock(&memcomp_select_lock);
+	now = jiffies;
+	if (select->boot_codec_pending) {
+		if (time_before(now, select->boot_codec_deadline)) {
+			queue_delayed_work(system_unbound_wq, &select->work,
+					   select->boot_codec_deadline - now);
+			goto out;
+		}
+		select->boot_codec_pending = false;
+		select->deadline = now + MEMCOMP_COMPRESSOR_WAIT;
+	}
 	if (select->decided) {
 		if (select->started)
 			memcomp_async_init(select->pool, select->compressor);
@@ -5772,6 +5792,10 @@
 
 	/* Listen first, so a registration racing the check is not missed. */
 	memcomp_select.deadline = jiffies + MEMCOMP_COMPRESSOR_WAIT;
+	if (IS_ENABLED(CONFIG_SYSFS) && memcomp_codec_wait && !memcomp_force_off) {
+		memcomp_select.boot_codec_pending = true;
+		memcomp_select.boot_codec_deadline = jiffies + MEMCOMP_BOOT_CODEC_WAIT;
+	}
 	ret = crypto_register_notifier(&memcomp_select.nb);
 	if (ret)
 		return ret;
@@ -5803,6 +5827,51 @@
