 }
 
+static ssize_t boot_compressor_show(struct kobject *kobj,
+				    struct kobj_attribute *attr, char *buf)
+{
+	const char *state;
+
+	mutex_lock(&memcomp_select_lock);
+	if (!memcomp_codec_wait || memcomp_force_off)
+		state = "unavailable";
+	else if (memcomp_select.boot_codec_pending)
+		state = "pending";
+	else if (!memcomp_select.decided)
+		state = "starting";
+	else
+		state = memcomp_select.started ? "locked" : "unavailable";
+	mutex_unlock(&memcomp_select_lock);
+	return sysfs_emit(buf, "%s\n", state);
+}
+
+static ssize_t boot_compressor_store(struct kobject *kobj,
+				     struct kobj_attribute *attr,
+				     const char *buf, size_t count)
+{
+	const char *name;
+	ssize_t ret = -EBUSY;
+
+	if (sysfs_streq(buf, "zstd"))
+		name = "zstd";
+	else if (sysfs_streq(buf, "lz4"))
+		name = "lz4";
+	else
+		return -EINVAL;
+
+	mutex_lock(&memcomp_select_lock);
+	if (memcomp_select.boot_codec_pending &&
+	    time_before(jiffies, memcomp_select.boot_codec_deadline)) {
+		strscpy(memcomp_compressor, name, sizeof(memcomp_compressor));
+		memcomp_select.boot_codec_pending = false;
+		memcomp_select.deadline = jiffies + MEMCOMP_COMPRESSOR_WAIT;
+		mod_delayed_work(system_unbound_wq, &memcomp_select.work, 0);
+		ret = count;
+	}
+	mutex_unlock(&memcomp_select_lock);
+	return ret;
+}
