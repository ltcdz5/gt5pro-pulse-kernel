+	zstd_update_params(ctx, READ_ONCE(compression_level));
+	wksp_size = zstd_cctx_workspace_bound(&ctx->params.cParams);
 
 	ctx->cwksp = vzalloc(wksp_size);
 	if (!ctx->cwksp) {
