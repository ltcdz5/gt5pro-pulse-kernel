 static uint __read_mostly compression_level = 1;
 module_param(compression_level, uint, 0644);
 
+/*
+ * A negative Zstd level only raises the match search acceleration; it does not
+ * change the frame format.  Zstd spends much of a single-page frame on fixed
+ * per-frame work, so trading search effort for speed costs little ratio here
+ * while cutting the time a faulting task or kswapd spends compressing.
+ */
+static int __read_mostly fast_level = -1;
+module_param(fast_level, int, 0444);
+
 struct zstd_ctx {
 	zstd_cctx *cctx;
 	zstd_dctx *dctx;
 	void *cwksp;
 	void *dwksp;
+	zstd_parameters params;
+	unsigned int level;
 };
 
-static zstd_parameters zstd_params(void)
+static void zstd_update_params(struct zstd_ctx *ctx, unsigned int level)
 {
-	if (compression_level == 0)
-		compression_level = 1;
-	if (compression_level > zstd_max_clevel())
-		compression_level = zstd_max_clevel();
-	return zstd_get_params(compression_level, PAGE_SIZE);
+	unsigned int normalized = clamp_t(unsigned int, level, 1, zstd_max_clevel());
+
+	if (level != normalized)
+		cmpxchg(&compression_level, level, normalized);
+	if (fast_level < 0 && normalized == 1)
+		ctx->params = zstd_get_params(
+			clamp_t(int, fast_level, zstd_min_clevel(), -1),
+			PAGE_SIZE);
+	else
+		ctx->params = zstd_get_params(normalized, PAGE_SIZE);
+	ctx->level = normalized;
 }
 
