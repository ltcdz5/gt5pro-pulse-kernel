+static ssize_t compressor_store(struct kobject *kobj,
+				struct kobj_attribute *attr,
+				const char *buf, size_t count)
+{
+	enum memcomp_codec_id codec;
+	const char *name;
+	int ret = 0;
+
+	if (sysfs_streq(buf, "zstd"))
+		codec = MEMCOMP_CODEC_ZSTD;
+	else if (sysfs_streq(buf, "lz4"))
+		codec = MEMCOMP_CODEC_LZ4;
+	else
+		return -EINVAL;
+
+	mutex_lock(&memcomp_select_lock);
+	if (!memcomp_available()) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	name = memcomp_runtime_codecs[codec].name;
+	if (!strcmp(name, memcomp_compressor))
+		codec = MEMCOMP_CODEC_BOOT;
+	if (codec != MEMCOMP_CODEC_BOOT) {
+		ret = memcomp_prepare_codec(codec);
+		if (ret)
+			goto out;
+	}
+	memcomp_async_init(memcomp_pool_for_codec(codec), name, codec);
+	smp_store_release(&memcomp_active_codec, codec);
+out:
+	mutex_unlock(&memcomp_select_lock);
+	return ret ? ret : count;
+}
