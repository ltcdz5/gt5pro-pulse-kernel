+static int memcomp_prepare_codec(enum memcomp_codec_id id)
+{
+	struct memcomp_runtime_codec *codec = &memcomp_runtime_codecs[id];
+	struct crypto_comp *tfm;
+	unsigned int index;
+	int cpu;
+
+	lockdep_assert_held(&memcomp_select_lock);
+	if (codec->ready)
+		return 0;
+
+	for (index = 0; index < memcomp_nr_comp_ctxs; index++) {
+		tfm = crypto_alloc_comp(codec->name, 0, CRYPTO_NOLOAD);
+		if (IS_ERR(tfm))
+			goto out_free;
+		codec->enc[index] = tfm;
+	}
+	for_each_possible_cpu(cpu) {
+		tfm = crypto_alloc_comp(codec->name, 0, CRYPTO_NOLOAD);
+		if (IS_ERR(tfm))
+			goto out_free;
+		per_cpu(memcomp_decomp_ctxs, cpu).runtime_tfm[id] = tfm;
+	}
+	smp_store_release(&codec->ready, true);
+	return 0;
+
+out_free:
+	for_each_possible_cpu(cpu) {
+		struct crypto_comp **decoder =
+			&per_cpu(memcomp_decomp_ctxs, cpu).runtime_tfm[id];
+
+		if (*decoder)
+			crypto_free_comp(*decoder);
+		*decoder = NULL;
+	}
+	while (index) {
+		index--;
+		crypto_free_comp(codec->enc[index]);
+		codec->enc[index] = NULL;
+	}
+	return PTR_ERR(tfm);
+}
