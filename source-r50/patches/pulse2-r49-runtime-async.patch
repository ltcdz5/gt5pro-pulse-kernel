+static ssize_t async_enabled_show(struct kobject *kobj,
+				  struct kobj_attribute *attr, char *buf)
+{
+	if (!memcomp_is_enabled() ||
+	    !smp_load_acquire(&memcomp_async_pool.ready))
+		return sysfs_emit(buf, "unavailable\n");
+
+	return sysfs_emit(buf, "%u\n", READ_ONCE(memcomp_async_on));
+}
+
+static ssize_t async_enabled_store(struct kobject *kobj,
+				   struct kobj_attribute *attr,
+				   const char *buf, size_t count)
+{
+	bool enabled;
+
+	if (kstrtobool(buf, &enabled))
+		return -EINVAL;
+	if (!memcomp_is_enabled() ||
+	    !smp_load_acquire(&memcomp_async_pool.ready))
+		return -EOPNOTSUPP;
+
+	WRITE_ONCE(memcomp_async_on, enabled);
+	return count;
+}
